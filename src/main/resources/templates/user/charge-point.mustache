            amountDisplay.innerText = selectedAmount.toLocaleString();
            chargeBtn.disabled = false;
        });
    });*/

    document.querySelector("#point-btn-group").addEventListener("click", function (event) {
        // 클릭한 곳에서 가장 가까운 .point-btn찾기
        const btn = event.target.closest(".point-btn");
        pointBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        selectedAmount = Number(btn.dataset.amount);
        amountDisplay.innerText = selectedAmount.toLocaleString();
        chargeBtn.disabled = false;
    });

    chargeBtn.addEventListener("click", async function () {
        if (selectedAmount <= 0) return;
        chargeBtn.disabled = true;

        try {
            const prepareRes = await fetch("/api/payment/prepare", {
                method: "POST",
                headers: {"Content-Type" : "application/json"},
                body: JSON.stringify({amount: selectedAmount})
            });
            const prepare = await prepareRes.json();
